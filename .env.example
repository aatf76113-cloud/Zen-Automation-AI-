# Environment Variables Template
# Copy this file to .env for local server-side runtime secrets.
# NEVER commit .env to version control.

# Google Gemini API Key (Required for server-side AI workflows & agents)
GEMINI_API_KEY=

# NVIDIA NIM API Key (Optional for NVIDIA models like DeepSeek & Moonshot)
NVIDIA_API_KEY=

# APInex API Key (Optional unified gateway for DeepSeek, Claude, Kimi, Gemini)
APINEX_API_KEY=

# Application URL
APP_URL=

# Node Environment ('development' | 'production')
NODE_ENV=

# WhatsApp Business Cloud API (Server-Side Secrets only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v19.0
WHATSAPP_APP_SECRET=

